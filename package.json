{
  "name": "headlesswordpress",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev-no-tls": "NODE_TLS_REJECT_UNAUTHORIZED=0 astro dev",
    "start": "astro dev",
    "build": "biome check --fix && astro check && astro build",
    "format": "biome check --fix",
    "preview": "astro preview",
    "cfPreview": "wrangler pages dev ./dist --compatibility-date=2025-09-02 --compatibility-flag=nodejs_compat",
    "astro": "astro",
    "purgecss": "node ./purge.js",
    "dbcfdeploy": "wrangler pages deployment tail",
    "pagefind": "tsx ./makePageFindIndex.js",
    "pflocal": "WORDPRESS_GQL_URL=https://bieldev.wpengine.com/index.php?graphql    PUBLIC_DATA_API_URL=https://api.bibleineverylanguage.org/v1/graphql SITE_URL=http://localhost:4321 tsx ./makePageFindIndex.ts",
    "test:e2e": "bun playwright test",
    "test:e2e-mock-ci-local": "CI=true bun playwright test --ui",
    "test:e2e:open-report": "bun playwright show-report"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.24.1",
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.8",
    "@astrojs/sitemap": "^3.5.1",
    "@astrojs/solid-js": "^5.1.1",
    "@kobalte/core": "^0.13.11",
    "@sindresorhus/slugify": "^3.0.0",
    "@solid-primitives/intersection-observer": "^2.2.2",
    "@solid-primitives/media": "^2.3.3",
    "@tanstack/solid-virtual": "^3.13.12",
    "@types/qrcode": "^1.5.5",
    "@wordpress/base-styles": "^6.6.0",
    "@wordpress/block-library": "^9.30.0",
    "astro": "5.13.5",
    "client-zip": "1.7.0",
    "htmlrewriter": "^0.0.13",
    "intl-tel-input": "^25.10.8",
    "linkedom": "^0.18.12",
    "pdfjs-dist": "^5.4.149",
    "qrcode": "^1.5.4",
    "ramda": "^0.31.3",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@cloudflare/workers-types": "^4.20250913.0",
    "@iconify/json": "^2.2.384",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.4.0",
    "@types/ramda": "^0.31.1",
    "@unocss/preset-icons": "66.5.1",
    "@unocss/reset": "66.5.1",
    "@unocss/transformer-directives": "66.5.1",
    "@unocss/transformer-variant-group": "66.5.1",
    "@vite-pwa/astro": "^1.1.0",
    "glob": "^11.0.3",
    "pagefind": "^1.4.0",
    "purgecss": "^7.0.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.92.1",
    "tsx": "^4.20.5",
    "unocss": "66.5.1",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-recipes": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0",
    "wrangler": "^4.37.0"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}

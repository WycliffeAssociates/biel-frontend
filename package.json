{
	"name": "headlesswordpress",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"dev-no-tls": "NODE_TLS_REJECT_UNAUTHORIZED=0 astro dev",
		"start": "astro dev",
		"build": "biome check --fix && astro check && astro build",
		"format": "biome check --fix",
		"preview": "astro preview",
		"cfPreview": "wrangler pages dev ./dist",
		"astro": "astro",
		"purgecss": "node ./purge.js",
		"dbcfdeploy": "wrangler pages deployment tail",
		"pagefind": "tsx ./makePageFindIndex.js",
		"pflocal": "WORDPRESS_GQL_URL=https://bieldev.wpengine.com/index.php?graphql    PUBLIC_DATA_API_URL=https://api.bibleineverylanguage.org/v1/graphql SITE_URL=http://localhost:4321 tsx ./makePageFindIndex.ts",
		"test:e2e": "pnpm exec playwright test",
		"test:e2e-mock-ci-local": "CI=true pnpm exec playwright test --ui",
		"test:e2e:open-report": "pnpm exec playwright show-report"
	},
	"dependencies": {
		"@ark-ui/solid": "^5.6.0",
		"@astrojs/check": "^0.9.4",
		"@astrojs/cloudflare": "^12.5.0",
		"@astrojs/sitemap": "^3.3.0",
		"@astrojs/solid-js": "^5.0.8",
		"@kobalte/core": "^0.13.9",
		"@sindresorhus/slugify": "^2.2.1",
		"@solid-primitives/intersection-observer": "^2.2.0",
		"@solid-primitives/media": "^2.3.0",
		"@tanstack/solid-virtual": "^3.13.6",
		"@wordpress/base-styles": "^5.22.0",
		"@wordpress/block-library": "^9.22.0",
		"astro": "^5.7.4",
		"client-zip": "1.6.3",
		"htmlrewriter": "^0.0.12",
		"intl-tel-input": "^25.3.1",
		"linkedom": "^0.18.9",
		"pdfjs-dist": "^5.1.91",
		"ramda": "^0.30.1",
		"solid-js": "^1.9.5",
		"typescript": "^5.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@cloudflare/workers-types": "^4.20250422.0",
		"@iconify/json": "^2.2.330",
		"@playwright/test": "^1.52.0",
		"@types/node": "^22.14.1",
		"@types/ramda": "^0.30.2",
		"@unocss/preset-icons": "66.1.0-beta.12",
		"@unocss/reset": "66.1.0-beta.12",
		"@unocss/transformer-directives": "66.1.0-beta.12",
		"@unocss/transformer-variant-group": "66.1.0-beta.12",
		"@vite-pwa/astro": "^1.0.1",
		"glob": "^11.0.1",
		"pagefind": "^1.3.0",
		"purgecss": "^7.0.2",
		"rollup-plugin-visualizer": "^5.14.0",
		"sass": "^1.87.0",
		"tsx": "^4.19.3",
		"unocss": "66.1.0-beta.12",
		"vite": "^6.3.2",
		"vite-plugin-pwa": "^1.0.0",
		"workbox-cacheable-response": "^7.3.0",
		"workbox-core": "^7.3.0",
		"workbox-expiration": "^7.3.0",
		"workbox-precaching": "^7.3.0",
		"workbox-recipes": "^7.3.0",
		"workbox-routing": "^7.3.0",
		"workbox-strategies": "^7.3.0",
		"workbox-window": "^7.3.0",
		"wrangler": "^4.12.1"
	}
}

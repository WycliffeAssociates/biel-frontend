		"@tanstack/solid-virtual": "3.13.24",
		"@wordpress/base-styles": "6.20.0",
		"@wordpress/block-library": "9.44.0",
		"astro": "6.1.8",
		"client-zip": "1.6.3",
		"htmlrewriter": "0.0.13",
		"intl-tel-input": "27.1.3",

		"@astrojs/sitemap": "3.7.2",
		"@astrojs/solid-js": "6.0.1",
		"@kobalte/core": "0.13.11",
		"@sindresorhus/slugify": "3.0.0",
		"@solid-primitives/intersection-observer": "2.2.4",

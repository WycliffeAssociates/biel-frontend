{
  "name": "headlesswordpress",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev-no-tls": "NODE_TLS_REJECT_UNAUTHORIZED=0 astro dev",
    "start": "astro dev",
    "build": "biome check --fix && astro check && astro build",
    "format": "biome check --fix",
    "preview": "astro preview",
    "cfPreview": "wrangler pages dev ./dist",
    "astro": "astro",
    "purgecss": "node ./purge.js",
    "dbcfdeploy": "wrangler pages deployment tail",
    "pagefind": "tsx ./makePageFindIndex.js",
    "pflocal": "WORDPRESS_GQL_URL=https://bieldev.wpengine.com/index.php?graphql    PUBLIC_DATA_API_URL=https://api.bibleineverylanguage.org/v1/graphql tsx ./makePageFindIndex.ts",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e-mock-ci-local": "CI=true pnpm exec playwright test --ui",
    "test:e2e:open-report": "pnpm exec playwright show-report"
  },
  "dependencies": {
    "@ark-ui/solid": "^4.7.0",
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.1.0",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/solid-js": "^5.0.1",
    "@kobalte/core": "^0.13.7",
    "@sindresorhus/slugify": "^2.2.1",
    "@solid-primitives/media": "^2.2.9",
    "@tanstack/solid-virtual": "^3.11.2",
    "@wordpress/base-styles": "^5.15.0",
    "@wordpress/block-library": "^9.15.1",
    "astro": "^5.1.2",
    "client-zip": "1.6.2",
    "htmlrewriter": "^0.0.12",
    "intl-tel-input": "^25.2.1",
    "linkedom": "^0.18.6",
    "ramda": "^0.30.1",
    "solid-js": "^1.9.3",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@iconify/json": "^2.2.291",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/ramda": "^0.30.2",
    "@unocss/preset-icons": "^0.65.3",
    "@unocss/reset": "^0.65.3",
    "@unocss/transformer-directives": "^0.65.3",
    "@unocss/transformer-variant-group": "^0.65.3",
    "@vite-pwa/astro": "^0.5.0",
    "glob": "^11.0.0",
    "pagefind": "^1.3.0",
    "purgecss": "^7.0.2",
    "rollup-plugin-visualizer": "^5.13.1",
    "sass": "^1.83.0",
    "tsx": "^4.19.2",
    "unocss": "^0.65.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-recipes": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0",
    "wrangler": "^3.99.0"
  }
}

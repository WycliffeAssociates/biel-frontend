---
export const prerender = false;
import {HeaderMenu} from "@components/HeaderMenu";
import ResourceSingle from "@components/ResourceSingle/ResourceSingle.astro";
import {BreadCrumbs} from "@components/BreadCrumbs";
import Layout from "@layouts/LayoutNoFooter.astro";
import {getMenus, getLanguagesPageSlugs, getWpmlLanguages} from "@src/data/wp";
import {getDict} from "@src/i18n/strings";
import {capitalizeFirstLetter, titleCase} from "@src/utils";
import {constants} from "@lib/constants";
import {getLanguageContents} from "@src/data/pubDataApi";

const {resourceLang} = Astro.params;
if (!resourceLang) return Astro.redirect("/404");
const gqlUrl =
  Astro.locals?.runtime?.env.WORDPRESS_GQL_URL ||
  import.meta.env.WORDPRESS_GQL_URL ||
  process.env.WORDPRESS_GQL_URL;
const restUrl =
  Astro.locals?.runtime?.env.WORDPRESS_REST_MENU_ENDPOINT ||
  import.meta.env.WORDPRESS_REST_MENU_ENDPOINT ||
  process.env.WORDPRESS_REST_MENU_ENDPOINT;

const pubDataApiUrl = Astro.locals?.runtime?.env.PUBLIC_DATA_API;
const paramsLower = new URLSearchParams(
  Array.from(Astro.url.searchParams, ([key, value]) => [
    key.toLowerCase(),
    value,
  ])
);
const doBustCache = !!paramsLower.get(constants.queryParamCacheBust);
const cache = Astro.locals.runtime.caches.default;
const ctx = Astro.locals.runtime.ctx;

const [wpmlLangDict, menus, languagePageSlugs] = await Promise.all([
  getWpmlLanguages({gqlUrl}),
  getMenus({restUrl}),
  getLanguagesPageSlugs({gqlUrl}),
]);

const parts = resourceLang.split("/").filter(Boolean);
const isEnglishDetailPage = parts[0] === "resources" && parts.length === 3;
const isDetailPageOther = parts.length === 4;
const thisLang = isEnglishDetailPage ? "en" : parts[0];
if (!thisLang) return Astro.redirect("/404");
const i18nDict = getDict(thisLang, true);
const pubDataIetf = parts[parts.length - 1];
if (!pubDataIetf) return Astro.redirect("/404");
const thisTranslation = languagePageSlugs.data.page.translations.find(
  (t) => t.languageCode === thisLang
);

const isReqForResources =
  thisTranslation?.slug === parts[2] ||
  isEnglishDetailPage ||
  (isDetailPageOther && thisTranslation?.slug === parts[3]);

if (!isReqForResources) Astro.redirect("/404");

const langInfo = wpmlLangDict[thisLang]
  ? wpmlLangDict[thisLang]
  : wpmlLangDict.en;
if (!langInfo) return Astro.redirect("/404");
const nonHiddenLanguages = new Set(Object.keys(menus));
const headerMenu =
  menus[langInfo.language_code]?.["header-menu"] || menus.en?.["header-menu"]!;
const langSwitcherList = Object.values(wpmlLangDict)
  .filter((lang) => {
    return nonHiddenLanguages.has(lang.code);
  })
  .map((lang) => {
    // Don't mutate the original dict item
    const copy = {...lang};
    const matchingSlug = languagePageSlugs.data.page.translations.find(
      (t) => t.languageCode === lang.code
    );

    if (lang.code === "en") {
      copy.localizedUrl = `/resources/languages/${pubDataIetf}`;
    } else {
      copy.localizedUrl = `${matchingSlug?.uri}/${pubDataIetf}`;
    }
    // resource/en or es/recursos/lang

    return copy;
  });

// language api data:
const data = await getLanguageContents({
  language: pubDataIetf,
  cache,
  ctx,
  pubDataApiUrl,
  doBustCache,
  siteLanguage: langInfo.code,
});
const {data: languageData} = data;

// Stuff for breadbrumbs
const nodes = [
  {
    uri: isEnglishDetailPage ? "/" : `/${thisLang}`,
    slug: "",
    title: i18nDict!.home,
  },
];

switch (parts.length) {
  case 3:
    // resource/languages/en
    isEnglishDetailPage &&
      nodes.push(
        {
          uri: "/resources",
          slug: "",
          title: "Resources",
        },
        {
          uri: "/resources/languages",
          slug: "",
          title: capitalizeFirstLetter(parts[1]!),
        },
        {
          uri: `/resources/languages/${languageData.language.national_name}`,
          slug: "",
          title: languageData.language.national_name,
        }
      );
    break;
  case 4:
    // es/recursos/idiomas/fr
    isDetailPageOther &&
      nodes.push(
        {
          slug: thisTranslation?.slug!,
          title: capitalizeFirstLetter(parts[1]!),
          uri: `/${parts[0]!}/${parts[1]!}`,
        },
        {
          slug: "",
          title: capitalizeFirstLetter(thisTranslation?.title!),
          uri: `/${parts[0]!}/${parts[1]!}/${parts[2]!}`,
        },
        {
          slug: "",
          title: capitalizeFirstLetter(parts[3]!),
          uri: `/${parts[0]!}/${parts[1]!}/${parts[2]!}/${languageData.language.national_name}`,
        }
      );
    break;
  default:
    break;
}
const crumbs = {
  nodes: nodes,
};
const ogImage = `${Astro.site?.origin}/icon-512.png`;
---

<Layout
  title={titleCase({
    lang: langInfo.code,
    str: `${languageData.language.englishName} ${i18nDict!.siteName}`,
  })}
  inlineCss={[]}
  description={`${i18nDict!.siteName} - ${parts[parts.length - 1]}`}
  langInfo={langInfo}
  langSwitcher={langSwitcherList}
  langDirection="ltr"
  siteName={i18nDict!.siteName}
  ogImage={ogImage}
>
  <HeaderMenu
    allLangs={langSwitcherList}
    currentLang={langInfo}
    menu={headerMenu}
    i18nDict={i18nDict!}
    client:load
  />
  <BreadCrumbs crumbs={crumbs} />

  <div class="md:pt-8 mx-auto h-full overflow-auto w-full contain contain-pad">
    <ResourceSingle
      languageData={languageData}
      languageToFetch={pubDataIetf}
      i18nDict={i18nDict!}
      siteLanguage={langInfo.code}
    />
  </div>
</Layout>

---
export const prerender = true;
import Blocks from "@components/Blocks.astro";
import {BreadCrumbs} from "@components/BreadCrumbs";
import ContactPage from "@components/ContactPage.astro";
import ScriptureEngagment from "@components/ScriptureEngagement/ScriptureE.astro";
import {getCollection} from "astro:content";

import {HeaderMenu} from "@components/HeaderMenu";
import Hero from "@components/Hero.astro";
import SearchPage from "@components/SearchPage.astro";
import Layout from "@layouts/Layout.astro";
import {blocksAreEmpty} from "@lib/web";
import {
  getEnglishUriMap,
  getGlobal,
  getMenus,
  getPage,
  getSeFormPage,
  getWpmlLanguages,
} from "@src/data/wp";
import {getDict} from "@src/i18n/strings";
import {
  addOptionalSectionsToCmsPages,
  adjustCmsDomLinks,
  collectInlineStyles,
  determineShowGlobal,
  doShowPageTitle,
  doShowTopBlurb,
  isNotCustomPage,
  titleCase,
} from "@src/utils";
import {DOMParser} from "linkedom/worker";
import {env} from "cloudflare:workers";

type StaticPathProps = {
  langCode: string;
  wpUri: string;
  localizedUrls: Record<string, string>;
};

type SharedRouteDataArgs = {
  gqlUrl: string;
  restUrl: string;
};

let sharedRouteDataCache:
  | {
      key: string;
      promise: ReturnType<typeof loadSharedRouteData>;
    }
  | undefined;

function getSharedRouteData({gqlUrl, restUrl}: SharedRouteDataArgs) {
  const key = `${gqlUrl}:${restUrl}`;
  if (!sharedRouteDataCache || sharedRouteDataCache.key !== key) {
    sharedRouteDataCache = {
      key,
      promise: loadSharedRouteData({gqlUrl, restUrl}),
    };
  }
  return sharedRouteDataCache.promise;
}

async function loadSharedRouteData({gqlUrl, restUrl}: SharedRouteDataArgs) {
  const [menus, ctaGlobal, wpmlLangDict, {englishUriMap}, scriptureEngagementPages] =
    await Promise.all([
      getMenus({restUrl}),
      getGlobal({
        slug: "cta-interior-2",
        langCode: "en",
        gqlUrl,
      }),
      getWpmlLanguages({gqlUrl}),
      getEnglishUriMap({gqlUrl}),
      getSeFormPage({gqlUrl}),
    ]);

  return {
    menus,
    ctaGlobal,
    wpmlLangDict,
    englishUriMap,
    scriptureEngagementPages,
  };
}

export async function getStaticPaths() {
  try {
    const pages = await getCollection("wpPages");
    return pages.map((entry) => {
      const normalizedSlug = entry.data.routeUri.replace(/^\/+|\/+$/g, "");
      return {
        params: {
          slug: normalizedSlug === "" ? undefined : normalizedSlug,
        },
        props: {
          langCode: entry.data.langCode,
          wpUri: entry.data.wpUri,
          localizedUrls: entry.data.localizedUrls,
        } satisfies StaticPathProps,
      };
    });
  } catch (error) {
    console.error(error);
    return [];
  }
}
const gqlUrl =
  env.WORDPRESS_GQL_URL ||
  import.meta.env.WORDPRESS_GQL_URL ||
  process.env.WORDPRESS_GQL_URL;
const restUrl =
  env.WORDPRESS_REST_MENU_ENDPOINT ||
  import.meta.env.WORDPRESS_REST_MENU_ENDPOINT ||
  process.env.WORDPRESS_REST_MENU_ENDPOINT;

const {langCode, wpUri, localizedUrls} = Astro.props as StaticPathProps;
const [pageData, sharedRouteData] = await Promise.all([
  getPage({uri: wpUri, langCode, gqlUrl}),
  getSharedRouteData({gqlUrl, restUrl}),
]);
const {
  menus,
  ctaGlobal,
  wpmlLangDict,
  englishUriMap,
  scriptureEngagementPages,
} = sharedRouteData;
const page = pageData;
if (!page) return new Response(null, {status: 404});

if (page.isHomePage && langCode !== "en") {
  page.uri = `/${langCode}`;
  page.otherVersions[langCode] = page.uri;
}

const ctaSection = addOptionalSectionsToCmsPages({
  targetLang: langCode,
  sectionToAdd: ctaGlobal?.allLangsGlobal,
});

let inlineStyles: string[] = [];
try {
  const srcResponse = await fetch(page.link.replace("https", "http"));
  const pageRendered = await srcResponse.text();
  const dom = new DOMParser().parseFromString(pageRendered, "text/html");
  inlineStyles = collectInlineStyles({
    dom,
    additionalStyles: [ctaGlobal?.inlineStyles],
  });
} catch (error) {
  console.error("inline style fetch failed", error);
}

const nonHiddenLanguages = new Set(Object.keys(menus));
const langInfo = wpmlLangDict[langCode] || wpmlLangDict.en;
if (!langInfo) return new Response(null, {status: 404});
const headerMenu =
  menus[langInfo.language_code]?.["header-menu"] || menus.en?.["header-menu"]!;
const langSwitcherList = Object.values(wpmlLangDict)
  .filter((lang) => nonHiddenLanguages.has(lang.code))
  .map((lang) => {
    const copy = {...lang};
    const mapped = localizedUrls[copy.code];
    if (mapped) {
      copy.localizedUrl =
        mapped === "/" && copy.code !== "en" ? `/${copy.code}` : mapped;
    } else if (copy.code === "en") {
      copy.localizedUrl = "/";
    } else if (copy.code === langCode && page.isHomePage) {
      copy.localizedUrl = `/${copy.code}`;
    }
    return copy;
  });

const blockHtmlWithClientInjections = page?.editorBlocks
  .filter((b) => b.parentClientId == null)
  .map((block) => {
    // do some client side injections of components here if needed
    return block.renderedHtml;
  });
const metaDescription =
  page.pageOptions?.topBlurb ||
  blockHtmlWithClientInjections.join(" ").slice(0, 100);
const ogImage = `${Astro.site?.origin}/icon-512.png`;
const pageDict = getDict(langInfo.code, true)!;
---

<Layout
  title={titleCase({
    lang: langInfo.code,
    str: `${page.title} ${pageDict.siteName}`,
  })}
  inlineCss={inlineStyles}
  langInfo={langInfo}
  langSwitcher={langSwitcherList}
  description={metaDescription}
  langDirection="ltr"
  isFormPage={page.isContactPage || page.isScriptureEngagmentPage}
  siteName={pageDict.siteName}
  ogImage={ogImage}
>
  <header class="header">
    <HeaderMenu
      allLangs={langSwitcherList}
      currentLang={langInfo}
      menu={headerMenu}
      i18nDict={pageDict}
      client:load
    />
  </header>
  <main
    data-pagefind-meta="type:page"
    class={`${!page.isHomePage ? "interior-page" : "homePage"} ${page.isScriptureEngagmentPage && "scripture-engagement-page"}`}
  >
    {!page.isHomePage && <BreadCrumbs crumbs={page.ancestors} />}

    {
      doShowTopBlurb(page) && (
        <div class="headless-insertion wp-blocks site-hero">
          <Hero
            pageOptions={page.pageOptions}
            title={page.title}
            featuredImage={page.featuredImage}
            readMoreAnchorWords={pageDict.learnMoreLink}
          />
        </div>
      )
    }
    {
      doShowPageTitle(page) && (
        <h1 class="text-center text-6xl mb-12 ">{page.title}</h1>
      )
    }

    {
      isNotCustomPage(page) && (
        <div
          id="mainContent"
          class={`headless-insertion wp-blocks ${
            !page.isHomePage && "site-container"
          }`}
        >
          {page.editorBlocks
            .filter((b) => b.parentClientId == null)
            .map((block) => {
              return (
                <Blocks
                  content={adjustCmsDomLinks({
                    stringToParse: block.renderedHtml,
                    englishUriMap,
                    currentLangCode: langInfo.code,
                  })}
                />
              );
            })}
          {blocksAreEmpty(page.editorBlocks) && (
            <h2 class="">{pageDict.notYetTranslated}</h2>
          )}
        </div>
      )
    }
    <!-- CONTACT PAGE -->
    {
      page.isContactPage && (
        <ContactPage
          languageCode={langInfo.language_code}
          editorBlocks={page.editorBlocks}
          notTranslatedYet={blocksAreEmpty(page.editorBlocks)}
          dict={pageDict}
          scriptureEngagementPages={scriptureEngagementPages}
        />
      )
    }
    <!-- SEARCH PAGE -->
    {
      page.isSearchPage && (
        <SearchPage
          dict={pageDict}
          languageCode={langInfo.code}
          langSwitcherList={langSwitcherList}
        />
      )
    }
    {
      page.isScriptureEngagmentPage && (
        <ScriptureEngagment langCode={langInfo.code} i18nDict={pageDict} />
      )
    }
    {
      determineShowGlobal({page, global: ctaSection}) && (
        <div class="headless-insertion overflow-hidden">
          <Blocks
            content={adjustCmsDomLinks({
              stringToParse: ctaSection?.content!,
              englishUriMap,
              currentLangCode: langInfo.code,
            })}
          />
        </div>
      )
    }
  </main>
</Layout>

<script>
  const aTags = document.querySelectorAll("a");
  const origin = window.location.origin;
  aTags.forEach((tag) => {
    if (tag.href.includes(origin)) {
      // https://bieldev.wpengine.com/processes/
      const split = tag.href.split(origin);
      if (split[1] && split[1] == "/") {
        const prefaced = `${origin}`;
        tag.href = prefaced;
      } else {
        const prefaced = `${origin}/${split[1]}`;
        tag.href = prefaced;
      }
    } else if (tag.href.startsWith("/")) {
      tag.href = `/${tag.href.slice(1)}`;
    }
  });

  function platformHighlight() {
    const platformCards = document.querySelectorAll(".platform-detect");
    if (platformCards) {
      const userAgent = navigator.userAgent;
      const ua = userAgent.toLowerCase();
      const isMac = ua.includes("mac");
      // const isWindows = ua.includes("win");
      const isLinux = ua.includes("linux");
      const isAndroid = ua.includes("android");
      const isIOS = ua.includes("iphone") || ua.includes("ipad");
      const macClass = "platform-detect-mac";
      const linuxClass = "platform-detect-linux";
      const androidClass = "platform-detect-android";
      const iosClass = "platform-detect-ios";
      const mapper = {
        [macClass]: isMac,
        [linuxClass]: isLinux,
        [androidClass]: isAndroid,
        [iosClass]: isIOS,
      };

      platformCards.forEach((card) => {
        Object.entries(mapper).forEach(([className, platform]) => {
          if (card.classList.contains(className) && !!platform) {
            card.classList.add("active");
          }
        });
      });
    }
  }
  platformHighlight();
</script>

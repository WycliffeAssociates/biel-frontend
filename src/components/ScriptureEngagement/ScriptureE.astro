---
import "intl-tel-input/build/css/intlTelInput.css";
import {ScriptureEngagementForm} from "./ScriptureEngagement";
import type {i18nDictType} from "@src/i18n/strings";

type Props = {
  langCode: string;
  i18nDict: i18nDictType;
};
const {langCode, i18nDict} = Astro.props;
const turnstilePublicKey =
  Astro.locals?.runtime?.env.TURNSTILE_PUBLIC_KEY ||
  import.meta.env.TURNSTILE_PUBLIC_KEY ||
  process.env.TURNSTILE_PUBLIC_KEY;
---

<div
  class={"headless-insertion contain-pad font-step-0 md:bg-surface-secondary md:py-20"}
>
  <ScriptureEngagementForm
    languageCode={langCode}
    i18nDict={i18nDict}
    turnstilePublicKey={turnstilePublicKey}
    client:load
  />
</div>

<style is:global>
  .iti__search-input {
    padding: 4px;
  }
</style>

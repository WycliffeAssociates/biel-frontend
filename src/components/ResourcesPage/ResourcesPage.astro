---
import {constants} from "@lib/constants";
import {getLanguagesWithContentForBiel} from "@src/data/pubDataApi";
import {ResourceIndex} from "./Main";
import type {i18nDictType} from "@src/i18n/strings";
import type {ResourceTypeToIetfList} from "@src/data/github";
import { env } from "cloudflare:workers";
interface Props {
  detailPrefix: string;
  i18nDict: i18nDictType;
  siteIetf: string;
  tsFilesByResourceType: ResourceTypeToIetfList;
  tsFileLocalization: Record<string, string>;
}
const startTime = performance.now();
const referrer = Astro.request.headers.get("Referer") as string;
const referrerUrl = new URL(referrer);
const params = Array.from(referrerUrl.searchParams)
  .filter(([key]) => {
    return !!key && typeof key === "string";
  })
  .map(([key, value]) => {
    return [key.toLowerCase(), value];
  });
const paramsLower = new URLSearchParams(params);
const doBustCache = !!paramsLower.get(constants.queryParamCacheBust);
const resourceType = paramsLower.get(constants.queryParamResourceType);
const resourceTypeArrQp = resourceType
  ? resourceType
      .split("|")
      .filter((t) => !!t && typeof t === "string")
      .map((t) => t.trim().toLowerCase())
  : [];

// note, cache is a noop in dev right now for cloudfalre adapter
const cache =
  caches.default as unknown as import("@cloudflare/workers-types").Cache;
const ctx = Astro.locals.cfContext;
const pubDataApiUrl =
  env.PUBLIC_DATA_API ||
  import.meta.env.PUBLIC_DATA_API ||
  process.env.PUBLIC_DATA_API ||
  "";
const {
  detailPrefix,
  i18nDict,
  siteIetf,
  tsFilesByResourceType,
  tsFileLocalization,
} = Astro.props as Props;
const {data, wasCached, resourceTypeToDisplayName} =
  await getLanguagesWithContentForBiel({
    cache,
    ctx,
    pubDataApiUrl,
    doBustCache,
    siteLanguage: siteIetf,
  });

if (!data) return Astro.redirect("/404");
const endTime = performance.now();
const totalTime = endTime - startTime;
console.log(
  `time for resources index route on server ${totalTime} ms.
  Was cached: ${wasCached}. `
);
---

<div class="contain contain-pad">
  <ResourceIndex
    client:load
    i18nDict={i18nDict}
    languages={data.data.language}
    detailPrefix={detailPrefix}
    resourceTypeToDisplayName={resourceTypeToDisplayName}
    tsFileLocalization={tsFileLocalization}
    resourceTypeArrSearchParams={resourceTypeArrQp}
    tsFilesByResourceType={tsFilesByResourceType}
  />
</div>

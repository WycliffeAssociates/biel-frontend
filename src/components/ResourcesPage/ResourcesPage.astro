---
import {getLanguagesWithContentForBiel} from "@src/data/pubDataApi";
import type {i18nDictType} from "@src/i18n/strings";
import {ResourceIndex} from "./Main";
interface Props {
  detailPrefix: string;
  i18nDict: i18nDictType;
  siteIetf: string;
}
const startTime = performance.now();
const runtime = Astro.locals.runtime;
const referrer = Astro.request.headers.get("Referer") as string;
const referrerUrl = new URL(referrer);
const doBustCache = !!referrerUrl.searchParams.get("cache-bust");
const resourceType = referrerUrl.searchParams.get("resource-type");
const resourceTypeArrQp = resourceType
  ? resourceType.split("|").map((t) => t.trim().toLowerCase())
  : [];
console.log(`resourceType: ${resourceType}`);
// note, cache is a noop in dev right now for cloudfalre adapter
const cache = runtime.caches.default;
const ctx = runtime.ctx;
const pubDataApiUrl = runtime.env.PUBLIC_DATA_API;
const {detailPrefix, i18nDict, siteIetf} = Astro.props;
const {data, wasCached, resourceTypeToDisplayName} =
  await getLanguagesWithContentForBiel({
    cache,
    ctx,
    pubDataApiUrl,
    doBustCache,
    siteLanguage: siteIetf,
  });

if (!data) return Astro.redirect("/404");
const endTime = performance.now();
const totalTime = endTime - startTime;
console.log(
  `time for resources index route on server ${totalTime} ms.
  Was cached: ${wasCached}. `
);
---

<div class="contain contain-pad">
  <ResourceIndex
    client:load
    i18nDict={i18nDict}
    languages={data.data.language}
    detailPrefix={detailPrefix}
    resourceTypeToDisplayName={resourceTypeToDisplayName}
    resourceTypeArrQps={resourceTypeArrQp}
  />
</div>

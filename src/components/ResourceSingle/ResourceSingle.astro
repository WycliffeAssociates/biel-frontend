---
import type {i18nDictType} from "@src/i18n/strings";
interface Props {
  languageToFetch: string;
  i18nDict: i18nDictType;
  siteLanguage: string;
  languageData: LangWithContent;
  doBustCache: boolean;
}
import {ResourceWrapper} from "@components/ResourceSingle/ResourceWrapper";
import {constants} from "@lib/constants";
import {getTsFiles} from "@src/data/github";
import type {LangWithContent} from "@src/data/gqlQueries/queries";
import {env} from "cloudflare:workers";

const {languageToFetch, i18nDict, languageData, doBustCache} = Astro.props;
let tsFiles: Awaited<ReturnType<typeof getTsFiles>> | undefined;
try {
  tsFiles = await getTsFiles(languageToFetch);
} catch (error) {
  console.error("Failed to load TS files for resource single route", {
    languageToFetch,
    error,
  });
}
const docUiUrl = env.DOC_UI_URL as string;
const paramsLower = new URLSearchParams(
  Array.from(Astro.url.searchParams, ([key, value]) => [
    key.toLowerCase(),
    value,
  ]),
);

const {contents, language: lang} = languageData;

const resource = paramsLower.get(constants.queryParamResourceType) || null;
const book = paramsLower.get(constants.queryParamsLangContentsBook) || null;
const chapter =
  paramsLower.get(constants.queryParamsLangContentsChapter) || null;
const download =
  paramsLower.get(constants.queryParamsLangContentsDownload) || null;
const queryParams = {resource, book, chapter, download};
---

<section data-name="pubDataApi" class="contain h-full">
  <div class="h-full">
    <ResourceWrapper
      client:load
      queryParams={queryParams}
      language={lang}
      contents={contents}
      tsFiles={tsFiles}
      i18nDict={i18nDict}
      docUiUrl={docUiUrl}
      doBustCache={doBustCache}
    />
  </div>
</section>

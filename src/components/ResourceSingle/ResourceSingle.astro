---
import type {i18nDictType} from "@src/i18n/strings";
interface Props {
  languageToFetch: string;
  i18nDict: i18nDictType;
  siteLanguage: string;
}
import {ResourceWrapper} from "@components/ResourceSingle/ResourceWrapper";
import {constants} from "@lib/constants";
import {getTsFiles} from "@src/data/github";
import {getLanguageContents} from "@src/data/pubDataApi";

const {languageToFetch, i18nDict, siteLanguage} = Astro.props;
const startTime = performance.now();
const tsFiles = await getTsFiles(languageToFetch);
const cache = Astro.locals.runtime.caches.default;
const ctx = Astro.locals.runtime.ctx;
const pubDataApiUrl = Astro.locals.runtime.env.PUBLIC_DATA_API;
const docUiUrl = Astro.locals.runtime.env.DOC_UI_URL as string;
const paramsLower = new URLSearchParams(
  Array.from(Astro.url.searchParams, ([key, value]) => [
    key.toLowerCase(),
    value,
  ])
);
const doBustCache = !!paramsLower.get(constants.queryParamCacheBust);

const data = await getLanguageContents({
  language: languageToFetch,
  cache,
  ctx,
  pubDataApiUrl,
  doBustCache,
  siteLanguage,
});
const {data: languageData, wasCached} = data;

const {contents, language: lang} = languageData;
const endTime = performance.now();
const totalTime = endTime - startTime;
console.log(
  `Time for language ${languageToFetch} route on server ${totalTime} ms.  
  Was cache match is ${wasCached}`
);

const resource = paramsLower.get(constants.queryParamResourceType) || null;
const book = paramsLower.get(constants.queryParamsLangContentsBook) || null;
const chapter =
  paramsLower.get(constants.queryParamsLangContentsChapter) || null;
const download =
  paramsLower.get(constants.queryParamsLangContentsDownload) || null;
const queryParams = {resource, book, chapter, download};
---

<section data-name="pubDataApi" class="contain h-full">
  <div class="h-full">
    <ResourceWrapper
      client:load
      queryParams={queryParams}
      language={lang}
      contents={contents}
      tsFiles={tsFiles}
      i18nDict={i18nDict}
      docUiUrl={docUiUrl}
    />
  </div>
</section>

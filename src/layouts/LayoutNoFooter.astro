---
import "../styles/wordpress.scss";
import "../styles/global.scss";
import "../styles/vars.scss";
import "../styles/reader.css";
import type {languageType} from "@customTypes/types";
import {pwaInfo} from "virtual:pwa-info";
import {hrefLangUrl} from "@src/utils";

interface Props {
  title: string;
  langInfo: languageType;
  langSwitcher: languageType[];
  inlineCss: string[];
  description: string;
  langDirection: "ltr" | "rtl";
  siteName: string;
  ogImage: string;
}

const {
  title,
  inlineCss,
  langInfo,
  langSwitcher,
  description,
  langDirection,
  siteName,
  ogImage,
} = Astro.props;
const allStyles = [...inlineCss];
const deduped = new Set(allStyles);
const dedupedInlineStyles = [...deduped].join("\n");
---

<html lang={langInfo.code} dir={langDirection}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" /><!-- 180×180 -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={siteName} property="og:site_name" />
    <meta content={ogImage} property="og:image" />
    <title>{title}</title>
    {inlineCss && <style id="headlessStyles" set:html={dedupedInlineStyles} />}
    <script src="/src/pwa.ts"></script>
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    {
      langSwitcher.map((version) => {
        return (
          <link
            rel="alternate"
            href={hrefLangUrl(version, Astro)}
            hreflang={version.code}
          />
        );
      })
    }
    <!-- <ViewTransitions /> -->
  </head>
  <body>
    <div
      class="site bg-surface-primary grid h-100dvh grid-rows-[max-content_1fr_max-content] md:(grid-rows-[max-content_max-content_auto])"
    >
      <slot />
    </div>
  </body>
</html>

<script>
  if (import.meta.env.PROD) {
    // @ts-ignore
    const gtag: Gtag.Gtag = function () {
      window.dataLayer.push(arguments);
    };
    window.dataLayer = window.dataLayer || [];
    gtag("js", new Date());
    gtag("config", "G-ZJECQPPTKR");
  }
</script>
